+    """Return a SHA-256 hex digest identifying a guest."""
     return hashlib.sha256(guest_id.encode()).hexdigest()
 
 
 def generate_booking_ref():
+    """Return a random four-digit booking reference."""
     return secrets.randbelow(9000) + 1000
 
 
